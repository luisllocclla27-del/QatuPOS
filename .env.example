# Synthetic loopback database only. Production deployment requires explicit gates.
DATABASE_URL=postgresql://qatu_lab:qatu_lab_local_only@127.0.0.1:55432/qatupos_lab
API_PORT=4000
QATU_ENV=local

# Operational configuration: copy names into protected .env.operational, never commit values.
# QATU_ENV=production
# DATABASE_URL= (separate qatupos_prod_* database and individual DB credentials)
# QATU_PUBLIC_ORIGIN= (exact https://hostname[:port], no slash/path)
# QATU_TLS_CERT= (trusted certificate file outside repository)
# QATU_TLS_KEY= (protected private key file outside repository)
# QATU_HTTPS_BIND=0.0.0.0
# QATU_RESTAURANT_NAME=
# QATU_TABLE_COUNT=
# QATU_ADMIN_USERNAME=
# QATU_ADMIN_NAME=
# QATU_ADMIN_PASSWORD= (bootstrap only; remove after creation)

# Manual encrypted backup and isolated restore rehearsal. Never place real keys in this file.
# QATU_BACKUP_KEY_FILE= (protected binary 32-byte key outside checkout, separate from backup storage)
# QATU_BACKUP_FILE= (new .qatubak file outside checkout; no overwrite)
# QATU_GUEST_KEY_FILE= (EXISTING stable guest-code.key; do not generate a replacement)
# QATU_PG_BIN_DIR= (PostgreSQL17 bin directory; defaults to local pinned17.11)
# QATU_RESTORE_DATABASE_URL= (EMPTY isolated loopback qatupos_restore_<32hex> database)

# Supabase/Vercel: protected environment only. Never expose these via NEXT_PUBLIC.
# QATU_DEPLOYMENT=vercel
# QATU_ENV=production
# QATU_DEPLOYMENT_STAGE=production (preview requires staging and a separate project)
# QATU_SUPABASE_PROJECT_REF= (20 lowercase letters/digits)
# QATU_PUBLIC_ORIGIN= (fixed exact HTTPS origin)
# QATU_GUEST_CODE_KEY_BASE64= (stable canonical base64 of32 cryptographically random bytes)
# DATABASE_URL= (qatu_pos_runtime.PROJECTREF via session pool5432, sslmode=verify-full)
# QATU_DATABASE_CA_BASE64= (canonical base64 PEM certificate downloaded from Supabase when required)
# ENABLE_EXPERIMENTAL_COREPACK=1
# Maintenance machine only; never upload these to Vercel:
# QATU_MAINTENANCE_DATABASE_URL= (postgres.PROJECTREF session5432 or direct5432, verified TLS)
# QATU_RUNTIME_DATABASE_PASSWORD= (individual random16..128 chars, install only)
# QATU_ADMIN_USERNAME=
# QATU_ADMIN_NAME=
# QATU_ADMIN_PASSWORD= (individual16..128 chars, install only)
# QATU_RESTAURANT_NAME=El Encanto Huamanguino
# QATU_TABLE_COUNT=
