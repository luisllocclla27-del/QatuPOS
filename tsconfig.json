{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@qatu/contracts": ["./packages/contracts/src/pos.ts"],
      "@qatu/domain": ["./packages/domain/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "services/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", ".runtime", "apps/pos/.next"]
}
